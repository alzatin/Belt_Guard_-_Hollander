            {
              "atomType": "GitHubMolecule",
              "x": 0.5221174764321972,
              "y": 0.2716049382716049,
              "uniqueID": "id-4089",
              "name": "selected.Fillet",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
